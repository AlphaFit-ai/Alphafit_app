{
  "name": "alphafit_ai",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "phone": "node scripts/phone.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint . --max-warnings 0",
    "test": "jest",
    "test:ci": "jest --ci",
    "i18n:check": "node scripts/check-i18n.js",
    "format": "node scripts/format-changed.js --write",
    "format:check": "node scripts/format-changed.js --check",
    "check": "npm run typecheck && npm run lint && npm run test:ci",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "preview:build": "node tools/preview/build.js",
    "preview:shots": "node tools/preview/shots.js",
    "preview:flows": "node tools/preview/flows.js",
    "preview:marketing": "node tools/preview/marketing.js"
  },
  "dependencies": {
    "@expo-google-fonts/urbanist": "^0.2.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/query-async-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "axios": "^1.13.2",
    "expo": "^58.0.0",
    "expo-apple-authentication": "~58.0.3",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "firebase": "^12.0.0",
    "i18next": "^25.10.10",
    "react": "19.3.0",
    "react-i18next": "^16.6.6",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "playwright-core": "^1.65.0",
    "prettier": "^3.10.1",
    "react-dom": "19.3.0",
    "react-native-web": "^0.21.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "$react",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo-router": {
      "@testing-library/react-native": "$@testing-library/react-native"
    }
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "<rootDir>/jest.globalSetup.js",
    "resolver": "<rootDir>/jest.resolver.js",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.{ts,tsx}"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testTimeout": 30000
  }
}

# Copy this file to `.env` for local development. `.env` is ignored by git.
# Variables that start with EXPO_PUBLIC_ are read by app.config.ts and end up inside the app, so never
# put a secret here.

# Address of the AlphaFit api, without a trailing slash. When this is not set the production api
# (https://api.alphafit-ai.com) is used. The EAS build profiles set their own in eas.json.
#
#   Android emulator, api from Alphafit-manifests/compose on this computer:  http://10.0.2.2:8180
#   Android phone on USB, after `adb reverse tcp:8180 tcp:8180`:              http://localhost:8180
#   Phone on the same Wi-Fi as this computer:                                http://<this computer's LAN address>:8180
#   iOS simulator:                                                           http://localhost:8180
#
# A development or preview EAS profile can set the same variable under "env" in eas.json instead.
EXPO_PUBLIC_API_URL=
